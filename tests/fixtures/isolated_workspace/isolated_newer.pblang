
type int builtin
type float builtin
type string builtin

// arrays
type MyArrayType = array<my_struct_type>
let array_var: MyArrayType = [{ field1=1, field2=2.5 }, { field1=2, field2=3.5 }];

// structs
struct my_struct_type {
    field1: int;
    field2: float;
}
let struct_var: my_struct_type = { field1=2, field2=3.5 };

// tuples
type my_tuple_type = (ab: int, cd: float)
let tuple_var: my_tuple_type = (ab=2, cd=3.5);

// maps
type my_map_type = map<string, int>
let map_var: my_map_type = { "key1"=1, "key2"=2, "key3"=3 };

// maps with arrays
type my_map_with_array_type = map<string, array<float>>
let map_with_array_var: my_map_with_array_type = { "abc"=[1, 3, 5], "def"=[2, 4, 6] };

// structs with arrays and maps
struct BigStruct {
    field1: int = 2;
    field2: array<float>;
    field3: map<string, float>;
}
struct BigStructWithDefaults {
    field1: int = 2;
    field2: array<float>=[1.0, 2.0, 3.0];
    field3: map<string, float>={ "key1"=1.0, "key2"=2.0 };
}
let my_big_struct: BigStructWithDefaults = {
    field1=2,
    field2=[1.0, 2.0, 3.0],
    field3={ "key1"=1.0, "key2"=2.0 }
};

// remote steps
remote step AddFloatsStep at "tests.fixtures.test_registry.toy_library.AddFloatsStep" {
    config (not_used: string)
    inputs (left: float, right: float)
    outputs (result: float)
}
let my_float_step: AddFloatsStep = AddFloatsStep(not_used="not used");
struct StoreType {
    A: float;
    B: float;
    C: float;
}
let my_store: StoreType = { A=1.0, B=2.0, C=3.0 };
let abc: float = my_store.A;
connect my_float_step inputs (left=my_store.A, right=my_store.B) outputs (result=my_store.C);

