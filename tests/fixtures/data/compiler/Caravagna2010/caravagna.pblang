type float builtin
type string builtin
type int builtin
type numpy_array_2d builtin
type list_string builtin

remote step ode_solver at "process_bigraph.tests.TelluriumStep" {
    config (model_path: string, num_steps: int)
    inputs (time: float, run_time: float)
    outputs (results_array: numpy_array_2d, results_labels: list_string)
}

// input variables
store time: float;
store run_time: float;

// output variables
store res_array: numpy_array_2d;
store res_labels: list_string;

let proc1: ode_solver = ode_solver(model_path = "models/Caravagna2010.xml", num_steps = 10);
connect proc1 inputs (time = time, run_time = run_time) outputs (results_array = res_array, results_labels = res_labels);
