// glucose and calcium uptake in three nested compartments
type float builtin

unit uM_per_h: ["10e-6 mole/liter/h"]
unit uM: ["10e-6 mole/liter"]
unit conc: uM_per_h
unit hour: ["h"]
unit dimensionless: ["1"]

remote process MyProcess at "my_processes.Process1" {
    config (calcium_growth: float, glucose_growth: float, dt: float, alpha: float)
    inputs (glucose: float, calcium: float)
    outputs (glucose: float, calcium: float)
}

struct Compartment {
    glucose: float;
    calcium: float;
}

let medium: Compartment = { glucose = 3.0, calcium = 0.5 };
let cell: Compartment = { glucose = 0.0, calcium = 0.0 };
let nucleus: Compartment = { glucose = 0.0, calcium = 0.0 };

let proc1: MyProcess = MyProcess(calcium_growth = 0.1, glucose_growth = 0.1, dt = 0.1, alpha = 0.1);
let proc2: MyProcess = MyProcess(calcium_growth = 0.1, glucose_growth = 0.1, dt = 0.1, alpha = 0.1);
let proc3: MyProcess = MyProcess(calcium_growth = 0.1, glucose_growth = 0.1, dt = 0.1, alpha = 0.1);

connect proc1 inputs (glucose = medium.glucose, calcium = medium.calcium) outputs (glucose = medium.glucose, calcium = medium.calcium);
connect proc2 inputs (glucose = cell.glucose, calcium = cell.calcium) outputs (glucose = cell.glucose, calcium = cell.calcium);
connect proc3 inputs (glucose = nucleus.glucose, calcium = nucleus.calcium) outputs (glucose = nucleus.glucose, calcium = nucleus.calcium);
