// types used by the spatio-flux dynamic FBA processes
type float builtin
type string builtin
type positive_float builtin

struct Bounds {
    lower: float;
    upper: float;
}

struct Particle {
    id: string;
    size: float;
    mass: float = 1.0;
}

struct Kinetics {
    vmax: float;
    kcat: float;
    role: string;   // reactant, product or enzyme
}

type Reaction = map<string, Kinetics>

// my model
type concentration = float
unit uM_per_h: ["10e-6 mole/liter/h"]
unit uM: ["10e-6 mole/liter"]
unit conc: uM_per_h
unit hour: ["h"]
unit dimensionless: ["1"]

store particle1: Particle;
store particle2: Particle;
init particle1 = { id = "particle1", size = 1.0, mass = 1.0 };
init particle2 = { id = "particle2", size = 1.0, mass = 1.0 };
