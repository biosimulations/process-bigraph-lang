// my model
type float builtin
type string builtin

remote process AddNums at "toy.AddFloatsRepeatedly" {
    inputs (left_hand_addend: float, right_hand_addend: float)
    outputs (result: float)
}

remote step PrintResult at "toy.SaveFloatToFile" {
    config (output_file_path: string)
    inputs (result: float)
}

store A: float;
store B: float;
store C: float;
init A = 2.07;
init B = 3.5;
init C = 0.0;

let add_nums: AddNums = AddNums();
let print_result: PrintResult = PrintResult(output_file_path = "~/abc_result.txt");
connect add_nums inputs (left_hand_addend = A, right_hand_addend = B) outputs (result = C);
connect print_result inputs (result = C);
