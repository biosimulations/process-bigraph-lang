// pblang v2 interface file — generated by describe from viva_pde_particle.steps.transfer
module viva_pde_particle.steps.transfer;

/// Grid fields → lookup fields for the particle engine, extended past a staircase PDE domain
/// (7e.5).
step ExtendGridField at "local:!viva_pde_particle.steps.transfer.ExtendGridField" {
  config { grid: map; species: list<string>; staircase: map; }
  inputs { fields: map<string, array<float>>; }
  outputs { lookup_fields: map<string, overwrite<array<float>>>; }
}

/// Per-node particle counts → µM on the same grid (``count / (V_element · 602.214)``).
step GridCountsToConcentration at "local:!viva_pde_particle.steps.transfer.GridCountsToConcentration" {
  config { grid: map; species: list<string>; staircase: map = {}; }
  inputs { particle_counts: map<string, array<float>>; }
  outputs { particle_conc: map<string, overwrite<array<float>>>; }
}

/// Grid histogram → P1 DOF concentrations through the transfer matrix: (Pᵀ·counts)/(M_L·602.214).
step GridCountsToMeshConcentration at "local:!viva_pde_particle.steps.transfer.GridCountsToMeshConcentration" {
  config { grid: map; mesh: map; species: list<string>; }
  inputs { particle_counts: map<string, array<float>>; }
  outputs { particle_conc: map<string, overwrite<array<float>>>; }
}

/// P1 DOF fields → grid fields for the particle engine's rate lookups: u_grid = P·u.
step MeshToGridField at "local:!viva_pde_particle.steps.transfer.MeshToGridField" {
  config { grid: map; mesh: map; species: list<string>; }
  inputs { field_dofs: map<string, array<float>>; }
  outputs { fields: map<string, overwrite<array<float>>>; }
}

/// Molecule positions → P1 DOF concentrations by the exact point load Σ_p φ_j(x_p)/(M_L,j·602.214).
step PositionsToMeshConcentration at "local:!viva_pde_particle.steps.transfer.PositionsToMeshConcentration" {
  config { grid: map; mesh: map; species: list<string>; }
  inputs { particle_positions: map<string, array<float>>; }
  outputs { particle_conc: map<string, overwrite<array<float>>>; }
}
