{
  "$schema": "https://biosimulations.github.io/process-bigraph-lang/schemas/pbg-interfaces-1.schema.json",
  "schema_version": "pbg-interfaces/1",
  "components": [
    {
      "name": "FVReactionDiffusion",
      "kind": "process",
      "address": "local:!viva_pde_particle.processes.fv_reaction_diffusion.FVReactionDiffusion",
      "module": "viva_pde_particle.processes.fv_reaction_diffusion",
      "config_schema": {
        "grid": "map",
        "pde": "map",
        "dt": {
          "_type": "float",
          "_default": 0.01
        },
        "domain": {
          "_type": "map",
          "_default": {}
        }
      },
      "inputs": {
        "fields": "map[array[float]]",
        "external_conc": "map[array[float]]"
      },
      "outputs": {
        "fields": "map[overwrite[array[float]]]"
      },
      "dynamic_ports": false,
      "description": "PDE half of a hybrid model (see :func:`viva_pde_particle.model.partition`)."
    },
    {
      "name": "SmoldynHybrid",
      "kind": "process",
      "address": "local:!viva_pde_particle.processes.smoldyn_hybrid.SmoldynHybrid",
      "module": "viva_pde_particle.processes.smoldyn_hybrid",
      "config_schema": {
        "grid": "map",
        "config_text": "string",
        "particle_species": "list[string]",
        "field_species": {
          "_type": "list[string]",
          "_default": []
        },
        "dt": {
          "_type": "float",
          "_default": 0.01
        },
        "step_multiplier": {
          "_type": "integer",
          "_default": 1
        },
        "quiet": {
          "_type": "boolean",
          "_default": true
        },
        "emit_positions": {
          "_type": "boolean",
          "_default": false
        }
      },
      "inputs": {
        "fields": "map[array[float]]"
      },
      "outputs": {
        "particle_counts": "map[overwrite[array[float]]]",
        "particle_totals": "map[overwrite[float]]",
        "particle_positions": "map[overwrite[array[float]]]"
      },
      "dynamic_ports": false,
      "description": "Particle half of a hybrid model."
    },
    {
      "name": "Stepper",
      "kind": "process",
      "address": "local:!viva_pde_particle.processes.stepper.Stepper",
      "module": "viva_pde_particle.processes.stepper",
      "config_schema": {
        "process": "map",
        "dt": "float",
        "every": {
          "_type": "integer",
          "_default": 1
        },
        "phase": {
          "_type": "integer",
          "_default": 0
        }
      },
      "inputs": null,
      "outputs": null,
      "dynamic_ports": true
    },
    {
      "name": "SplittingCoordinator",
      "kind": "process",
      "address": "local:!viva_pde_particle.processes.splitting.SplittingCoordinator",
      "module": "viva_pde_particle.processes.splitting",
      "config_schema": {
        "pde": "map",
        "particles": "map",
        "adapters": {
          "_type": "map",
          "_default": {}
        },
        "scheme": {
          "_type": "string",
          "_default": "jacobi"
        },
        "dt": "float",
        "step_multiplier": {
          "_type": "integer",
          "_default": 1
        }
      },
      "inputs": null,
      "outputs": null,
      "dynamic_ports": true
    },
    {
      "name": "GridRecorder",
      "kind": "process",
      "address": "local:!viva_pde_particle.processes.recorder.GridRecorder",
      "module": "viva_pde_particle.processes.recorder",
      "config_schema": {
        "out_dir": "string",
        "base_dt": "float",
        "every": "integer",
        "layout": "map",
        "species": "list[string]",
        "particle_species": {
          "_type": "list[string]",
          "_default": []
        },
        "membranes": {
          "_type": "map",
          "_default": {}
        },
        "region": {
          "_type": "string",
          "_default": "cell"
        },
        "source": {
          "_type": "string",
          "_default": ""
        }
      },
      "inputs": {
        "fields": "map[array[float]]",
        "particle_positions": "map[array[float]]"
      },
      "outputs": {},
      "dynamic_ports": false,
      "description": "Records ``fields`` on a Cartesian grid (``layout.kind == \"grid\"``)."
    },
    {
      "name": "MeshRecorder",
      "kind": "process",
      "address": "local:!viva_pde_particle.processes.recorder.MeshRecorder",
      "module": "viva_pde_particle.processes.recorder",
      "config_schema": {
        "out_dir": "string",
        "base_dt": "float",
        "every": "integer",
        "layout": "map",
        "species": "list[string]",
        "particle_species": {
          "_type": "list[string]",
          "_default": []
        },
        "membranes": {
          "_type": "map",
          "_default": {}
        },
        "region": {
          "_type": "string",
          "_default": "cell"
        },
        "source": {
          "_type": "string",
          "_default": ""
        }
      },
      "inputs": {
        "field_dofs": "map[array[float]]",
        "particle_positions": "map[array[float]]"
      },
      "outputs": {},
      "dynamic_ports": false,
      "description": "Records ``field_dofs`` on a P1 mesh (``layout.kind == \"mesh\"``)."
    },
    {
      "name": "ExtendGridField",
      "kind": "step",
      "address": "local:!viva_pde_particle.steps.transfer.ExtendGridField",
      "module": "viva_pde_particle.steps.transfer",
      "config_schema": {
        "grid": "map",
        "species": "list[string]",
        "staircase": "map"
      },
      "inputs": {
        "fields": "map[array[float]]"
      },
      "outputs": {
        "lookup_fields": "map[overwrite[array[float]]]"
      },
      "dynamic_ports": false,
      "description": "Grid fields \u2192 lookup fields for the particle engine, extended past a staircase PDE domain (7e.5)."
    },
    {
      "name": "GridCountsToConcentration",
      "kind": "step",
      "address": "local:!viva_pde_particle.steps.transfer.GridCountsToConcentration",
      "module": "viva_pde_particle.steps.transfer",
      "config_schema": {
        "grid": "map",
        "species": "list[string]",
        "staircase": {
          "_type": "map",
          "_default": {}
        }
      },
      "inputs": {
        "particle_counts": "map[array[float]]"
      },
      "outputs": {
        "particle_conc": "map[overwrite[array[float]]]"
      },
      "dynamic_ports": false,
      "description": "Per-node particle counts \u2192 \u00b5M on the same grid (``count / (V_element \u00b7 602.214)``)."
    },
    {
      "name": "GridCountsToMeshConcentration",
      "kind": "step",
      "address": "local:!viva_pde_particle.steps.transfer.GridCountsToMeshConcentration",
      "module": "viva_pde_particle.steps.transfer",
      "config_schema": {
        "grid": "map",
        "mesh": "map",
        "species": "list[string]"
      },
      "inputs": {
        "particle_counts": "map[array[float]]"
      },
      "outputs": {
        "particle_conc": "map[overwrite[array[float]]]"
      },
      "dynamic_ports": false,
      "description": "Grid histogram \u2192 P1 DOF concentrations through the transfer matrix: (P\u1d40\u00b7counts)/(M_L\u00b7602.214)."
    },
    {
      "name": "MeshToGridField",
      "kind": "step",
      "address": "local:!viva_pde_particle.steps.transfer.MeshToGridField",
      "module": "viva_pde_particle.steps.transfer",
      "config_schema": {
        "grid": "map",
        "mesh": "map",
        "species": "list[string]"
      },
      "inputs": {
        "field_dofs": "map[array[float]]"
      },
      "outputs": {
        "fields": "map[overwrite[array[float]]]"
      },
      "dynamic_ports": false,
      "description": "P1 DOF fields \u2192 grid fields for the particle engine's rate lookups: u_grid = P\u00b7u."
    },
    {
      "name": "PositionsToMeshConcentration",
      "kind": "step",
      "address": "local:!viva_pde_particle.steps.transfer.PositionsToMeshConcentration",
      "module": "viva_pde_particle.steps.transfer",
      "config_schema": {
        "grid": "map",
        "mesh": "map",
        "species": "list[string]"
      },
      "inputs": {
        "particle_positions": "map[array[float]]"
      },
      "outputs": {
        "particle_conc": "map[overwrite[array[float]]]"
      },
      "dynamic_ports": false,
      "description": "Molecule positions \u2192 P1 DOF concentrations by the exact point load \u03a3_p \u03c6_j(x_p)/(M_L,j\u00b7602.214)."
    }
  ]
}
