// pblang v2 - generated from BIOMD0000000012_url.sedml, task 'task1' (template: the solver is an open site)

// The role a solver fills: any step with this face. The generic COPASI and Tellurium steps have it.
step TimeCourseSolver {
  config { model_source: string; time: float; n_points: int; output_dir: string; }
  inputs { species_concentrations: map<string, float>; species_counts: map<string, float>; }
  outputs { result: numeric_result; }
}

param output_dir: string = ?;

// The SED-ML adapters (docs/v2/sedml-plan.md): solver-agnostic steps around the solver.
step DataGenerators at "local:pbsim_sedml.DataGenerators" {
  config {
    generators: map<string, list<{ variable: string; coefficient: float; }>>;
    constants: map<string, float>;
    skip: int;
  }
  inputs { result: numeric_result; }
  outputs { data: map<string, list<float>>; }
}

step Report at "local:pbsim_sedml.Report" {
  config {
    output_dir: string;
    reports: map<string, { file: string; name: string; data_sets: list<{ label: string; data_generator: string; }>; }>;
  }
  inputs { data: map<string, list<float>>; }
}

step Plots at "local:pbsim_sedml.Plots" {
  config {
    output_dir: string;
    plots: map<string, {
      file: string;
      name: string;
      kind: string;
      curves: list<{ name: string; x: string; y: string; }>;
      surfaces: list<{ name: string; x: string; y: string; z: string; }>;
      log_x: bool;
      log_y: bool;
      log_z: bool;
    }>;
  }
  inputs { data: map<string, list<float>>; }
}

meta {
  "sedml" = "BIOMD0000000012_url.sedml",
  "task" = "task1",
  "model" = "BIOMD0000000012_url",
  "simulation" = "auto_ten_seconds",
  "algorithm" = "KISAO:0000694",
  "output_start" = 0.0,
  "output_end" = 10.0,
  "number_of_steps" = 1000
}

