<?xml version="1.0" encoding="UTF-8"?>
<!-- Every SED-ML feature version 1 does not translate, once, next to one that it does: the describe test checks each
     is listed in `unsupported` with its element and id, and that the translatable task survives. -->
<sedML xmlns="http://sed-ml.org/sed-ml/level1/version4" level="1" version="4">
  <listOfModels>
    <model id="m" language="urn:sedml:language:sbml.level-3.version-2" source="model.xml">
      <listOfChanges>
        <changeAttribute target="/sbml:sbml/sbml:model/sbml:listOfSpecies/sbml:species[@id='A']/@initialConcentration" newValue="2.5"/>
        <computeChange target="/sbml:sbml/sbml:model/sbml:listOfParameters/sbml:parameter[@id='k']/@value"/>
      </listOfChanges>
    </model>
    <model id="remote" language="urn:sedml:language:sbml" source="urn:miriam:biomodels.db:BIOMD0000000001"/>
    <model id="cellml" language="urn:sedml:language:cellml" source="model.cellml"/>
  </listOfModels>
  <listOfSimulations>
    <uniformTimeCourse id="utc" initialTime="0" outputStartTime="5" outputEndTime="20" numberOfSteps="30">
      <algorithm kisaoID="KISAO:0000019">
        <listOfAlgorithmParameters>
          <algorithmParameter kisaoID="KISAO:0000211" value="1e-10"/>
        </listOfAlgorithmParameters>
      </algorithm>
    </uniformTimeCourse>
    <steadyState id="ss">
      <algorithm kisaoID="KISAO:0000282"/>
    </steadyState>
  </listOfSimulations>
  <listOfTasks>
    <task id="t" modelReference="m" simulationReference="utc"/>
    <task id="t_ss" modelReference="m" simulationReference="ss"/>
    <repeatedTask id="scan" range="r" resetModel="true"/>
  </listOfTasks>
  <listOfDataGenerators>
    <dataGenerator id="time">
      <listOfVariables><variable id="v_time" symbol="urn:sedml:symbol:time" taskReference="t"/></listOfVariables>
      <math xmlns="http://www.w3.org/1998/Math/MathML"><ci>v_time</ci></math>
    </dataGenerator>
    <dataGenerator id="a_scaled">
      <listOfVariables>
        <variable id="v_a" target="/sbml:sbml/sbml:model/sbml:listOfSpecies/sbml:species[@id='A']" taskReference="t"/>
        <variable id="v_b" target="/sbml:sbml/sbml:model/sbml:listOfSpecies/sbml:species[@id='B']" taskReference="t"/>
      </listOfVariables>
      <listOfParameters><parameter id="half" value="0.5"/></listOfParameters>
      <math xmlns="http://www.w3.org/1998/Math/MathML">
        <apply><minus/><apply><times/><ci>half</ci><ci>v_a</ci></apply><apply><divide/><ci>v_b</ci><cn>4</cn></apply></apply>
      </math>
    </dataGenerator>
    <dataGenerator id="a_squared">
      <listOfVariables><variable id="v_a2" target="/sbml:sbml/sbml:model/sbml:listOfSpecies/sbml:species[@id='A']" taskReference="t"/></listOfVariables>
      <math xmlns="http://www.w3.org/1998/Math/MathML"><apply><power/><ci>v_a2</ci><cn>2</cn></apply></math>
    </dataGenerator>
    <dataGenerator id="steady_a">
      <listOfVariables><variable id="v_sa" target="/sbml:sbml/sbml:model/sbml:listOfSpecies/sbml:species[@id='A']" taskReference="t_ss"/></listOfVariables>
      <math xmlns="http://www.w3.org/1998/Math/MathML"><ci>v_sa</ci></math>
    </dataGenerator>
  </listOfDataGenerators>
  <listOfOutputs>
    <report id="ok_report">
      <listOfDataSets>
        <dataSet id="ds_time" label="time" dataReference="time"/>
        <dataSet id="ds_a" label="A/2 - B/4" dataReference="a_scaled"/>
      </listOfDataSets>
    </report>
    <report id="squared_report">
      <listOfDataSets><dataSet id="ds_sq" label="A^2" dataReference="a_squared"/></listOfDataSets>
    </report>
    <plot2D id="log_plot">
      <xAxis type="linear"/>
      <yAxis type="log10"/>
      <listOfCurves><curve id="c1" name="A" xDataReference="time" yDataReference="a_scaled" logX="false"/></listOfCurves>
    </plot2D>
    <figure id="fig"/>
  </listOfOutputs>
</sedML>
