      bounds = { ATPM = { lower = 1.0, upper = 1.0 }, EX_o2_e = { lower = -2.0, upper = null } },
      kinetic_params = { acetate = (0.5, 2.0), glucose = (0.5, 1.0) },
      model_file = "textbook",
      substrate_update_reactions = { acetate = "EX_ac_e", glucose = "EX_glc__D_e" },
    }
    inputs {
      substrates { acetate -> fields.acetate[0][0], biomass -> fields.biomass[0][0], glucose -> fields.glucose[0][0] },
    }
    outputs {
      substrates { acetate -> fields.acetate[0][0], biomass -> fields.biomass[0][0], glucose -> fields.glucose[0][0] },
    }
