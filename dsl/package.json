{
    "name": "process-bigraph-lang",
    "version": "0.0.1",
    "description": "The .pblang language for process-bigraph composites: language server, VS Code extension, CLI and embeddable API",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/biosimulations/process-bigraph-lang.git",
        "directory": "dsl"
    },
    "publishConfig": {
        "access": "public"
    },
    "type": "module",
    "main": "./out/extension/main.cjs",
    "exports": {
        ".": {
            "types": "./out/api.d.ts",
            "default": "./out/api.js"
        },
        "./worker": {
            "types": "./out/language/main-browser.d.ts",
            "default": "./out/language/main-browser.js"
        },
        "./monarch": {
            "types": "./out/syntaxes/pblang.monarch.d.ts",
            "default": "./out/syntaxes/pblang.monarch.js"
        },
        "./textmate": "./syntaxes/pblang.tmLanguage.json",
        "./language-configuration": "./language-configuration.json",
        "./package.json": "./package.json"
    },
    "files": [
        "bin",
        "out",
        "src",
        "syntaxes",
        "language-configuration.json"
    ],
    "bin": {
        "process-bigraph-language-cli": "./bin/cli.js"
    },
    "scripts": {
        "build": "tsc -b tsconfig.src.json && node esbuild.mjs",
        "build:native": "tsc -b tsconfig.src.json && node esbuild.mjs && deno compile --output ./dist/cli-native --allow-all ./bin/cli.js",
        "watch": "concurrently -n tsc,esbuild -c blue,yellow \"tsc -b tsconfig.src.json --watch\" \"node esbuild.mjs --watch\"",
        "lint": "eslint src --ext ts",
        "langium:generate": "langium generate",
        "langium:generate:production": "langium generate --mode=production",
        "langium:watch": "langium generate --watch",
        "vscode:prepublish": "npm run build && npm run lint",
        "build:web": "npm run build",
        "bundle": "vite build",
        "bundle:serve": "http-server ./dist --port 5175",
        "dev": "vite",
        "dev:debug": "vite --debug --force",
        "serve": "npm run dev",
        "test": "vitest run",
        "prepack": "npm run langium:generate && npm run build",
        "pack": "npm pack --pack-destination dist"
    },
    "dependencies": {
        "chalk": "~5.3.0",
        "commander": "~13.0.0",
        "js-yaml": "^4.3.2",
        "langium": "~3.4.0",
        "mathjs": "~12.4.2",
        "vscode-languageclient": "~9.0.1",
        "vscode-languageserver": "~9.0.1"
    },
    "devDependencies": {
        "@codingame/esbuild-import-meta-url-plugin": "~1.0.2",
        "@codingame/monaco-vscode-editor-service-override": "~3.2.3",
        "@codingame/monaco-vscode-keybindings-service-override": "~3.2.3",
        "@types/js-yaml": "^4.0.9",
        "@types/node": "^18.0.0",
        "@types/vscode": "~1.67.0",
        "@typescript-eslint/eslint-plugin": "~7.3.1",
        "@typescript-eslint/parser": "~7.3.1",
        "concurrently": "~8.2.1",
        "esbuild": "~0.20.2",
        "eslint": "~8.57.0",
        "http-server": "~14.1.1",
        "langium-cli": "~3.4.0",
        "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~3.2.3",
        "monaco-editor-wrapper": "~4.0.2",
        "monaco-languageclient": "~8.1.1",
        "typescript": "~5.1.6",
        "vite": "~5.4.18",
        "vitest": "~1.4.0",
        "vscode": "npm:@codingame/monaco-vscode-api@~3.2.3"
    },
    "volta": {
        "node": "18.19.1",
        "npm": "10.2.4"
    },
    "displayName": "process-bigraph-lang",
    "engines": {
        "vscode": "^1.67.0",
        "node": ">=18.0.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "contributes": {
        "languages": [
            {
                "id": "pblang",
                "aliases": [
                    "Process Bigraph Language",
                    "pblang"
                ],
                "extensions": [
                    ".pblang",
                    ".pbl"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "pblang",
                "scopeName": "source.pblang",
                "path": "syntaxes/pblang.tmLanguage.json"
            }
        ]
    },
    "activationEvents": [
        "onLanguage:pblang"
    ]
}
