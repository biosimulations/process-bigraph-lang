{
    "projectName": "ProcessBigraphLanguage",
    "languages": [
        {
            "id": "pblang-v2",
            "grammar": "src/language/pblang-v2.langium",
            "fileExtensions": [".pblang", ".pbl"],
            "textMate": {
                "out": "syntaxes/pblang-v2.tmLanguage.json"
