{
    "projectName": "ProcessBigraphLanguage",
    "languages": [
        {
            "id": "pblang",
            "grammar": "src/language/pblang.langium",
            "fileExtensions": [".pblang", ".pbl"],
            "textMate": {
                "out": "syntaxes/pblang.tmLanguage.json"
            },
            "monarch": {
                "out": "src/syntaxes/pblang.monarch.ts"
            }
        }
    ],
    "out": "src/language/generated"
}
